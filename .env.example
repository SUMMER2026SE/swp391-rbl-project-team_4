PORT=9999
NODE_ENV=development

# SQL Server
DB_USER=sa
DB_PASSWORD=your_sql_server_password
DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=CinemaManagement
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true

# Payment / webhook
SEPAY_API_KEY=your_sepay_api_key
PAYMENT_WEBHOOK_SECRET=change_me_to_a_long_random_secret
SEPAY_BANK_CODE=MB
SEPAY_BANK_ACCOUNT=your_bank_account
SEPAY_ACCOUNT_NAME=YOUR ACCOUNT NAME
MOMO_BANK_ACCOUNT=your_momo_account
MOMO_ACCOUNT_NAME=YOUR MOMO NAME

# Auth / OAuth
JWT_SECRET=change_me_to_a_long_random_jwt_secret
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Email
SMTP_EMAIL=your_email@example.com
SMTP_APP_PASSWORD=your_smtp_app_password

# AI chatbot
GEMINI_API_KEY=your_gemini_api_key

# Reminders
REMINDER_MINUTES_BEFORE=5
REMINDER_SCAN_INTERVAL_MINUTES=1
REMINDER_ENABLED=true
